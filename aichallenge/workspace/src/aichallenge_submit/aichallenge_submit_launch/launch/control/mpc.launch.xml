<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="use_obstacle_avoidance" default="false"/>

  <!-- Track selection: citycircuit uses config.yaml/ref_vel.yaml; other tracks use config_<track>.yaml/ref_vel_<track>.yaml -->
  <arg name="track" default="citycircuit"/>
  <arg name="config_file" default="$(eval &quot;'config.yaml' if '$(var track)' == 'citycircuit' else 'config_' + '$(var track)' + '.yaml'&quot;)"/>
  <arg name="ref_vel_file" default="$(eval &quot;'ref_vel.yaml' if '$(var track)' == 'citycircuit' else 'ref_vel_' + '$(var track)' + '.yaml'&quot;)"/>

  <!-- Boost acceleration: MPC publishes AckermannControlBoostCommand to
       /boost_commander/command and boost_commander re-publishes it at 1700 Hz, which used
       to make older AWSIM builds apply the command several times per physics step.
       KEEP THIS OFF. Measured on the 2026-07-24 AWSIM: the flood is no longer amplified,
       it only starves the simulator, and lap 1 took 238 s against ~52 s without it. The
       accel ceiling it was meant to dodge does not exist in the sim either: the vehicle
       interface (and with it accel_map) is not launched, so AWSIM consumes control_cmd
       directly and mpc.a_max is the only accel clip that matters. -->
  <arg name="use_boost_acceleration" default="false"/>
  <!-- Longitudinal collision guard (AEB + slowdown for karts/walls ahead). -->
  <arg name="use_collision_guard" default="true"/>
  <!-- Wall(scan) AEB defaults OFF: current /scan source false-triggers. See collision_guard README. -->
  <arg name="use_scan_wall" default="false"/>
  <!-- Automatic recovery after hitting a wall or another kart. AWSIM's own
       wall recovery is off in the official evaluation, so without this a single
       contact ends the session beached at 0 m/s. See stuck_recovery/README.md. -->
  <arg name="use_stuck_recovery" default="true"/>
  <!-- Steer around a kart ahead instead of queueing behind it. Placed BEFORE the
       guard so that turning away takes the kart out of the guard's arc corridor
       and releases its speed cap by itself. See lateral_avoidance/README.md. -->
  <arg name="use_lateral_avoidance" default="false"/>

  <!-- Command chain, built from whichever filters are enabled:
         MPC -> lateral_avoidance -> collision_guard -> stuck_recovery -> vehicle
       Each disabled stage simply drops out and the topics shorten. Order is not
       arbitrary: avoidance goes FIRST so the guard sees the line we intend to
       take rather than braking for a kart we are already turning away from, and
       the recovery goes LAST because while it backs the car out of a wall the
       guard would otherwise brake for the very obstacle being escaped. -->
  <let name="mpc_out_topic"
       value="$(eval &quot;'/control/command/control_cmd_mpc' if '$(var use_lateral_avoidance)' == 'true' or '$(var use_collision_guard)' == 'true' or '$(var use_stuck_recovery)' == 'true' else '/control/command/control_cmd'&quot;)"/>
  <let name="avoid_out_topic"
       value="$(eval &quot;'/control/command/control_cmd_avoided' if '$(var use_collision_guard)' == 'true' or '$(var use_stuck_recovery)' == 'true' else '/control/command/control_cmd'&quot;)"/>
  <let name="guard_in_topic"
       value="$(eval &quot;'$(var avoid_out_topic)' if '$(var use_lateral_avoidance)' == 'true' else '$(var mpc_out_topic)'&quot;)"/>
  <let name="guard_out_topic"
       value="$(eval &quot;'/control/command/control_cmd_guarded' if '$(var use_stuck_recovery)' == 'true' else '/control/command/control_cmd'&quot;)"/>
  <let name="recovery_in_topic"
       value="$(eval &quot;'$(var guard_out_topic)' if '$(var use_collision_guard)' == 'true' else '$(var guard_in_topic)'&quot;)"/>

  <!-- Boost mode: the guard is bypassed. It is a Python node and cannot republish at
       1700 Hz, so putting it in the path would both throttle the boost and lag the
       command. Run with use_boost_acceleration:=false to race with the guard. -->
  <group if="$(var use_boost_acceleration)">
    <node pkg="multi_purpose_mpc_ros" exec="run_mpc_controller.bash"
          name="mpc_controller" output="screen"
          args="--config_path $(find-pkg-share multi_purpose_mpc_ros)/config/$(var config_file)
                --ref_vel_path $(find-pkg-share multi_purpose_mpc_ros)/config/$(var ref_vel_file)">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="use_boost_acceleration" value="true"/>
      <param name="use_obstacle_avoidance" value="$(var use_obstacle_avoidance)"/>
      <param name="use_stats" value="false"/>
    </node>

    <node pkg="multi_purpose_mpc_ros" exec="boost_commander"
          name="boost_commander" output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
  </group>

  <group unless="$(var use_boost_acceleration)">
    <!-- The MPC publishes to whatever comes next in the chain; with every filter
         disabled that is the vehicle topic itself (original behavior). -->
    <node pkg="multi_purpose_mpc_ros" exec="run_mpc_controller.bash"
          name="mpc_controller" output="screen"
          args="--config_path $(find-pkg-share multi_purpose_mpc_ros)/config/$(var config_file)
                --ref_vel_path $(find-pkg-share multi_purpose_mpc_ros)/config/$(var ref_vel_file)">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="use_boost_acceleration" value="false"/>
      <param name="use_obstacle_avoidance" value="$(var use_obstacle_avoidance)"/>
      <param name="use_stats" value="false"/>
      <remap from="/control/command/control_cmd" to="$(var mpc_out_topic)"/>
    </node>

    <group if="$(var use_lateral_avoidance)">
      <include file="$(find-pkg-share lateral_avoidance)/launch/lateral_avoidance.launch.xml">
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="input_cmd_topic" value="$(var mpc_out_topic)"/>
        <arg name="output_cmd_topic" value="$(var avoid_out_topic)"/>
      </include>
    </group>

    <group if="$(var use_collision_guard)">
      <include file="$(find-pkg-share collision_guard)/launch/collision_guard.launch.xml">
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="input_cmd_topic" value="$(var guard_in_topic)"/>
        <arg name="output_cmd_topic" value="$(var guard_out_topic)"/>
        <arg name="use_scan_wall" value="$(var use_scan_wall)"/>
      </include>
    </group>

    <group if="$(var use_stuck_recovery)">
      <include file="$(find-pkg-share stuck_recovery)/launch/stuck_recovery.launch.xml">
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="input_cmd_topic" value="$(var recovery_in_topic)"/>
        <!-- Intent is read upstream of the guard: a guard holding the car at
             0 m/s against the obstacle must not read as "the controller wants
             to stop", which is precisely the case being recovered from. -->
        <arg name="planned_cmd_topic" value="$(var mpc_out_topic)"/>
        <arg name="output_cmd_topic" value="/control/command/control_cmd"/>
      </include>
    </group>
  </group>
</launch>
